<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TeleportContract Condition="'$(TeleportContract)' == ''">Stable</TeleportContract>
    <DefineConstants>$(DefineConstants);TELEPORT_$(TeleportContract.ToUpperInvariant())</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\Compat\CompatSymbol.cs" LinkBase="Source" />
    <Compile Include="..\..\src\Compat\CompatMethodSignature.cs" LinkBase="Source" />
    <Compile Include="..\..\src\Compat\MethodResolver.cs" LinkBase="Source" />
    <Compile Include="..\..\src\Compat\ResolvedMethod.cs" LinkBase="Source" />
    <Compile Include="..\..\src\Compat\CompatibilityPatchAttribute.cs" LinkBase="Source" />
    <Compile Include="..\..\src\Compat\TeleportPosCompat*.cs" LinkBase="Source" />
    <Compile Remove="Fixtures\*.cs" />
    <Compile Include="Fixtures\$(TeleportContract)Teleport.cs" />
  </ItemGroup>
</Project>
