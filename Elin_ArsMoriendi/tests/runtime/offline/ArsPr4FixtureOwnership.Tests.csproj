    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <UseSharedCompilation>false</UseSharedCompilation>
    <GameRoot Condition="'$(GameRoot)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Elin</GameRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../src/cases/ArsPr4SummonOwnership.cs" Link="ArsPr4SummonOwnership.cs" />
