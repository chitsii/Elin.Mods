<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <AssemblyName>Pr8OfferingRuntimeCompile</AssemblyName>
    <LangVersion>latest</LangVersion>
    <DefineConstants>RUNTIME_TEST</DefineConstants>
    <RepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\..'))</RepositoryRoot>
    <ManagedDir>$(RepositoryRoot)\Elin_AutoOfferingAlter\elin_link\Elin_Data\Managed</ManagedDir>
    <SleepOfferAssembly Condition="'$(SleepOfferAssembly)' == ''">$(RepositoryRoot)\Elin_AutoOfferingAlter\_bin\Elin_AutoOfferingAlter.dll</SleepOfferAssembly>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" /><Reference Include="System.Core" /><Reference Include="Microsoft.CSharp" />
    <Reference Include="Elin_AutoOfferingAlter"><HintPath>$(SleepOfferAssembly)</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(RepositoryRoot)\Elin_AutoOfferingAlter\elin_link\BepInEx\core\0Harmony.dll</HintPath><Private>False</Private></Reference>
    <NativeAssembly Include="$(ManagedDir)\Elin.dll;$(ManagedDir)\Plugins.dll;$(ManagedDir)\Plugins.BaseCore.dll;$(ManagedDir)\Plugins.UI.dll;$(ManagedDir)\Plugins.Modding.dll;$(ManagedDir)\Newtonsoft.Json.dll;$(ManagedDir)\UnityEngine.dll;$(ManagedDir)\UnityEngine.CoreModule.dll;$(ManagedDir)\UnityEngine.UI.dll;$(ManagedDir)\UnityEngine.InputLegacyModule.dll" />
    <Reference Include="@(NativeAssembly)"><Private>False</Private></Reference>
    <Reference Include="BepInEx.Core"><HintPath>$(RepositoryRoot)\Elin_AutoOfferingAlter\elin_link\BepInEx\core\BepInEx.Core.dll</HintPath><Private>False</Private></Reference>
    <Compile Include="$(RepositoryRoot)\runtime-test-v2\framework\src\**\*.cs" Condition="'$(GeneratedCompileSource)' == ''" />
    <Compile Include="src\cases\*.cs;CompileConfiguration.cs" Condition="'$(GeneratedCompileSource)' == ''" />
    <Compile Include="$(GeneratedCompileSource)" Condition="'$(GeneratedCompileSource)' != ''" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
